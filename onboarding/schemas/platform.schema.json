{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idp.example.com/schemas/platform.schema.json",
  "title": "Internal Developer Platform Configuration",
  "description": "Schema for self-service platform onboarding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_name",
    "template_type",
    "template_version",
    "team_name",
    "docker_image",
    "environment"
  ],
  "properties": {
    "service_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,30}$",
      "description": "Unique service name."
    },
    "template_type": {
      "type": "string",
      "enum": [
        "web-service",
        "background-worker",
        "scheduled-job"
      ],
      "description": "Golden path template to use."
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Approved golden path template version."
    },
    "team_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,30}$",
      "description": "Owning team."
    },
    "docker_image": {
      "type": "string",
      "pattern": "^[0-9]+\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-zA-Z0-9._/-]+(:[a-zA-Z0-9._-]+|@sha256:[a-f0-9]{64})$",
      "description": "ECR container image."
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ],
      "description": "Deployment environment."
    }
  }
}